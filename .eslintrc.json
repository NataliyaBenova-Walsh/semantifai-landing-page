{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "all", // Check all variables
        "args": "none", // Ignore unused function arguments
        "ignoreRestSiblings": true // Ignore unused variables in destructuring
      }
    ]
  }
}


